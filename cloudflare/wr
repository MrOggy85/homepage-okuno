#!/bin/bash
# Runs wrangler inside this repo's tooling image (./Dockerfile), never on the host.
#   ./wr deploy                 build dist/ (build.sh) and deploy it
#   ./wr <wrangler args...>     anything else, e.g. ./wr whoami
# wrangler.jsonc is rendered from wrangler.template.jsonc and .env on every run; the API
# token comes from TOKEN_FILE and reaches the container only as an environment variable.
set -euo pipefail
export DOCKER_CONTEXT=rootless
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(dirname "$HERE")
WRANGLER_VERSION=$(sed -n 's/.*"wrangler": "\([^"]*\)".*/\1/p' "$HERE/package.json")
IMAGE="homepage-cf:$WRANGLER_VERSION"
docker image inspect "$IMAGE" >/dev/null 2>&1 || docker build -t "$IMAGE" "$HERE" >&2

[[ -f "$HERE/.env" ]] || { echo "no cloudflare/.env - copy .env.example" >&2; exit 1; }
. "$HERE/.env"
sed -e "s|__CF_ACCOUNT_ID__|$CF_ACCOUNT_ID|" -e "s|__HOSTNAME__|$HOSTNAME|" \
    -e "s|__ZONE__|$ZONE_NAME|" -e "s|__WORKERS_DEV__|${WORKERS_DEV:-false}|" \
    "$HERE/wrangler.template.jsonc" > "$HERE/wrangler.jsonc"

[[ "${1:-}" == deploy ]] && "$HERE/build.sh"

docker run --rm --env-file "$TOKEN_FILE" -e "CLOUDFLARE_ACCOUNT_ID=$CF_ACCOUNT_ID" \
  --cap-drop ALL --security-opt no-new-privileges \
  -v "$REPO":/work -w /work/cloudflare \
  -e HOME=/tmp/home -e XDG_CONFIG_HOME=/tmp/home/.config \
  "$IMAGE" sh -c 'ln -sfn /opt/cloudflare/node_modules node_modules && exec wrangler "$@"' -- "$@"
